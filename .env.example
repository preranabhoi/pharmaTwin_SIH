# PharmaTwin AI Environment Configuration

# Server Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# API Configuration
API_PREFIX=/api
APP_NAME="PharmaTwin AI"
APP_VERSION=0.1.0

# Database / Storage (Foundation)
DATABASE_URL=sqlite:///./pharmatwin.db

# Biomedical External Data / Services (Future Phase Foundation)
PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug
CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data
UNIPROT_API_BASE=https://rest.uniprot.org
STRING_DB_API_BASE=https://version-12-0.string-db.org/api
