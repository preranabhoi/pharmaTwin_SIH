# PharmaTwin AI Environment Configuration

# Server Settings
ENVIRONMENT=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# API Configuration
API_PREFIX=/api
APP_NAME="PharmaTwin AI"
APP_VERSION=0.2.0

# Database & Persistent Caching (SQLite)
DATABASE_URL=sqlite:///./pharmatwin.db
CACHE_TTL_HOURS=24

# Biomedical Data Ingestion Modes
ENABLE_EXTERNAL_SOURCES=False
DEMO_MODE=True

# External Biomedical Data API Endpoints
PUBCHEM_API_BASE=https://pubchem.ncbi.nlm.nih.gov/rest/pug
CHEMBL_API_BASE=https://www.ebi.ac.uk/chembl/api/data
UNIPROT_API_BASE=https://rest.uniprot.org
OPENTARGETS_API_BASE=https://api.platform.opentargets.org/api/v4/graphql
PUBMED_API_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
STRING_DB_API_BASE=https://version-12-0.string-db.org/api
